  <script is:inline define:vars={{ dateLocale: copy.dateLocale }}>
    (function () {
      function formatDate(value) {
        if (!value) return '—';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
      }
      document.querySelectorAll('[data-github-latest]').forEach(function (node) {
        var repo = node.getAttribute('data-github-latest');
        if (!repo) return;
        fetch('https://api.github.com/repos/' + repo + '/commits?per_page=1', { headers: { Accept: 'application/vnd.github.v3+json' } })
          .then(function (response) { return response.ok ? response.json() : Promise.reject(); })
          .then(function (data) {
            var date = Array.isArray(data) && data[0] && data[0].commit && data[0].commit.committer && data[0].commit.committer.date;
            node.textContent = formatDate(date);
          })
          .catch(function () { node.textContent = '—'; });
      });
    })();
  </script>
