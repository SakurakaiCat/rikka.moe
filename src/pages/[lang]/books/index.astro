---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SponsorWall from '../../../components/SponsorWall.astro';
import { LOCALES, toAbsoluteUrl, type Locale } from '../../../lib/content';
import { getBookCopy, type BookLang } from '../../../data/books-i18n';
import {
  DOWNLOAD_URL, AFDIAN_URL,
  screenshotGroups,
  journeyErrata, funcErrata,
  renderErrataTier,
} from '../../../data/books';

const bookPathForLocale = (loc: Locale) => loc.lang === 'zh-CN' ? '/books/' : `/${loc.lang_path}/books/`;

export async function getStaticPaths() {
  return LOCALES
    .filter((loc) => loc.lang !== 'zh-CN')
    .map((loc) => ({ params: { lang: loc.lang_path }, props: { locale: loc } }));
}

const { locale } = Astro.props as { locale: Locale };
const langMap: Record<string, BookLang> = { 'zh-TW': 'zh-TW', 'en': 'en', 'ja': 'ja' };
const copy = getBookCopy(langMap[locale.lang] || 'en');
const currentUrl = bookPathForLocale(locale);
const languageOptions = LOCALES.map((loc) => {
  const relativeUrl = bookPathForLocale(loc);
  return {
    ...loc,
    relativeUrl,
    absoluteUrl: toAbsoluteUrl('https://rikka.moe', relativeUrl),
    isCurrent: loc.lang === locale.lang,
  };
});
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  locale={locale}
  canonicalPath={currentUrl}
  image="/images/books/covers/func-math-cover.png"
  languageOptions={languageOptions}
>
  <article class="akari-books-landing akari-books-landing--localized">
    <section class="akari-books-hero-v2 glass-card" aria-labelledby="books-title">
      <div class="akari-books-hero-v2__content">
        <p class="akari-books-eyebrow">A Journey Through Mathematics</p>
        <h1 id="books-title">{copy.title}</h1>
        <p class="akari-books-hero-v2__english">THE JOURNEY OF MATHEMATICS</p>
        <p class="akari-books-hero-v2__lead">{copy.lead}</p>
        <div class="akari-books-chips" aria-label={copy.aria.chips}>
          {copy.chips.map((chip) => <span>{chip}</span>)}
        </div>
        <div class="akari-books-actions">
          <a class="akari-button akari-button--filled" href={DOWNLOAD_URL} target="_blank" rel="noopener noreferrer"><i class="ph ph-download-simple"></i>{copy.downloadLabel}</a>
          <a class="akari-button" href={AFDIAN_URL} target="_blank" rel="noopener noreferrer"><i class="ph ph-heart"></i>{copy.afdianLabel}</a>
          <a class="akari-button" href="#akari-book-showcase"><i class="ph ph-book-open"></i>{copy.buttons.explore}</a>
          <a class="akari-button" href="#akari-book-versions"><i class="ph ph-download-simple"></i>{copy.buttons.versions}</a>
        </div>
      </div>
      <div class="akari-books-hero-v2__covers" aria-hidden="true">
        <img class="akari-books-hero-v2__cover akari-books-hero-v2__cover--back" src="/images/books/covers/journey-cover.png" alt="" loading="eager" decoding="async" />
        <img class="akari-books-hero-v2__cover akari-books-hero-v2__cover--front" src="/images/books/covers/func-math-cover.png" alt="" loading="eager" decoding="async" />
      </div>
    </section>

    <nav class="akari-books-anchor-nav glass-card" aria-label={copy.aria.nav}>
      <a href="#akari-book-showcase"><i class="ph ph-books"></i><span>{copy.nav.overview}</span></a>
      <a href="#akari-book-errata"><i class="ph ph-list-checks"></i><span>{copy.nav.errata}</span></a>
      <a href="#akari-book-design"><i class="ph ph-pen-nib"></i><span>{copy.nav.design}</span></a>
      <a href="#akari-book-versions"><i class="ph ph-download-simple"></i><span>{copy.nav.versions}</span></a>
      <a href="#akari-book-method"><i class="ph ph-route"></i><span>{copy.nav.notes}</span></a>
      <a href="#akari-book-support"><i class="ph ph-heart"></i><span>{copy.nav.support}</span></a>
    </nav>

    <section class="akari-books-section akari-books-update-banner-section" aria-label="重大更新通知">
      <div class="akari-books-update-banner glass-card">
        <div class="akari-books-update-banner__icon"><i class="ph ph-megaphone-simple"></i></div>
        <div class="akari-books-update-banner__body">
          <p class="akari-books-eyebrow">{copy.update.eyebrow}</p>
          <h2>{copy.update.title}</h2>
          <p>{copy.update.body}</p>
          <div class="akari-books-actions">
            <a class="akari-button akari-button--filled" href={DOWNLOAD_URL} target="_blank" rel="noopener noreferrer"><i class="ph ph-download-simple"></i>{copy.downloadLabel}</a>
            <a class="akari-button" href="#akari-book-errata"><i class="ph ph-list-checks"></i>{copy.buttons.errata}</a>
          </div>
        </div>
      </div>
    </section>

    <section id="akari-book-showcase" class="akari-books-section">
      <header class="akari-books-section__header">
        <p class="akari-books-eyebrow">{copy.overview.eyebrow}</p>
        <h2>{copy.overview.title}</h2>
        <p>{copy.overview.lead}</p>
      </header>
      <div class="akari-books-feature-grid">
        <article class="akari-books-card glass-card">
          <i class="ph ph-pen-nib"></i>
          <p class="akari-books-badge">{copy.overview.funcBadge}</p>
          <h3>{copy.overview.funcTitle}</h3>
          <p>{copy.overview.funcBody}</p>
          <div class="akari-books-update"><i class="ph ph-git-commit"></i><span>{copy.overview.latest}</span><span data-github-latest="WritingMathBooks/func-math-book">{copy.overview.loading}</span></div>
        </article>
        <article class="akari-books-card glass-card">
          <i class="ph ph-books"></i>
          <p class="akari-books-badge">{copy.overview.journeyBadge}</p>
          <h3>{copy.overview.journeyTitle}</h3>
          <p>{copy.overview.journeyBody}</p>
          <div class="akari-books-update"><i class="ph ph-git-commit"></i><span>{copy.overview.latest}</span><span data-github-latest="ShinozakiKasumi/ProjectA-journey">{copy.overview.loading}</span></div>
        </article>
      </div>
    </section>

    <section id="akari-book-errata" class="akari-books-section">
      <header class="akari-books-section__header">
        <p class="akari-books-eyebrow">{`Errata`}</p>
        <h2>{copy.nav.errata}</h2>
      </header>
      <div class="akari-books-showcase glass-card">
        <div class="akari-books-tabs" role="tablist" aria-label="Errata book toggle">
          <button type="button" class="akari-books-tab akari-books-tab--active" role="tab" aria-selected="true" data-errata-tab="journey"><i class="ph ph-books"></i><span>{copy.errataTabs.journey}</span></button>
          <button type="button" class="akari-books-tab" role="tab" aria-selected="false" data-errata-tab="func"><i class="ph ph-pen-nib"></i><span>{copy.errataTabs.func}</span></button>
        </div>
        <div class="akari-errata-panel akari-errata-panel--active" data-errata-panel="journey">
          <Fragment set:html={journeyErrata.map((tier, i) => renderErrataTier(tier.label, tier.title, tier.items, i === 0)).join('')} />
        </div>
        <div class="akari-errata-panel" data-errata-panel="func" hidden>
          <Fragment set:html={funcErrata.map((tier, i) => renderErrataTier(tier.label, tier.title, tier.items, i === 0)).join('')} />
        </div>
      </div>
    </section>

    <section id="akari-book-design" class="akari-books-section">
      <header class="akari-books-section__header">
        <p class="akari-books-eyebrow">{copy.design.eyebrow}</p>
        <h2>{copy.design.title}</h2>
        <p>{copy.design.lead}</p>
      </header>
      <div class="akari-books-stats glass-card">
        {copy.design.stats.map((stat) => <article><strong>{stat.value}</strong><span>{stat.label}</span><p>{stat.desc}</p></article>)}
      </div>
      <div class="akari-books-feature-grid">
        {copy.design.features.map((feature) => (
          <article class="akari-books-card glass-card">
            <i class={`ph ph-${feature.icon}`}></i>
            <h3>{feature.title}</h3>
            <p>{feature.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="akari-book-versions" class="akari-books-section">
      <header class="akari-books-section__header">
        <p class="akari-books-eyebrow">{copy.versions.eyebrow}</p>
        <h2>{copy.versions.title}</h2>
        <p>{copy.versions.lead}</p>
      </header>
      <div class="akari-books-version-grid">
        <article class="akari-books-version glass-card">
          <p class="akari-books-badge">Free Edition</p>
          <h3>{copy.versions.freeTitle}</h3>
          <ul>{copy.versions.freeItems.map((item) => <li><i class="ph ph-check"></i>{item}</li>)}</ul>
          <a class="akari-button akari-button--filled" href={DOWNLOAD_URL} target="_blank" rel="noopener noreferrer"><i class="ph ph-download-simple"></i>{copy.downloadLabel}</a>
        </article>
        <article class="akari-books-version akari-books-version--primary glass-card">
          <p class="akari-books-badge">Watermark-Free Edition</p>
          <h3>{copy.versions.premiumTitle}</h3>
          <span class="akari-books-version__chip">{copy.versions.premiumChip}</span>
          <ul>{copy.versions.premiumItems.map((item) => <li><i class="ph ph-check-circle"></i>{item}</li>)}</ul>
          <a class="akari-button akari-button--filled" href={AFDIAN_URL} target="_blank" rel="noopener noreferrer"><i class="ph ph-heart"></i>{copy.afdianLabel}</a>
        </article>
      </div>
    </section>

    <section id="akari-book-screenshots" class="akari-books-section">
      <header class="akari-books-section__header">
        <p class="akari-books-eyebrow">{copy.preview.eyebrow}</p>
        <h2>{copy.preview.title}</h2>
        <p>{copy.preview.lead}</p>
      </header>
      <div class="akari-books-screenshot-groups">
        {screenshotGroups.map((group) => (
          <section class="akari-books-screenshot-group glass-card" aria-label={group.title}>
            <h3>{group.title}</h3>
            <div class="akari-books-screenshot-grid">
              {group.images.map((image) => <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />)}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section id="akari-book-method" class="akari-books-section">
      <header class="akari-books-section__header">
        <p class="akari-books-eyebrow">{copy.notes.eyebrow}</p>
        <h2>{copy.notes.title}</h2>
        <p>{copy.notes.lead}</p>
      </header>
      <div class="akari-books-method-grid">
        <article class="akari-books-text-card glass-card">
          <h3>{copy.notes.originTitle}</h3>
          {copy.notes.origin.map((paragraph) => <p>{paragraph}</p>)}
        </article>
        <article class="akari-books-text-card glass-card">
          <h3>{copy.notes.practiceTitle}</h3>
          {copy.notes.practice.map((paragraph) => <p>{paragraph}</p>)}
        </article>
      </div>
    </section>

    <section id="akari-book-support" class="akari-books-section">
      <header class="akari-books-section__header">
        <p class="akari-books-eyebrow">{copy.support.eyebrow}</p>
        <h2>{copy.support.title}</h2>
        <p>{copy.support.lead}</p>
      </header>
      <div class="akari-books-support-card glass-card">
        <div>
          <h3>{copy.support.cardTitle}</h3>
          <p>{copy.support.cardBody}</p>
          <a href={AFDIAN_URL} target="_blank" rel="noopener noreferrer">afdian.com/a/writeamathbook ↗</a>
        </div>
        <iframe id={`afdian_leaflet_writeamathbook_${locale.lang_path}`} src="https://ifdian.net/leaflet?slug=writeamathbook" width="640" height="200" scrolling="no" frameborder="0" loading="lazy" title="Afdian support card"></iframe>
      </div>
      <SponsorWall locale={locale} />
    </section>

    <section class="akari-books-section akari-books-akari-card glass-card">
      <img src="/akari-logo.svg" width="64" height="64" alt="Project Akari" loading="lazy" decoding="async" />
      <p class="akari-books-eyebrow">Project Akari</p>
      <h2>{copy.support.akariTitle}</h2>
      {copy.support.akariBody.map((paragraph) => <p>{paragraph}</p>)}
    </section>
  </article>

  <script is:inline define:vars={{ dateLocale: copy.dateLocale }}>
    (function () {
      function formatDate(value) {
        if (!value) return '—';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString(dateLocale, { year: 'numeric', month: 'long', day: 'numeric' });
      }
      document.querySelectorAll('[data-github-latest]').forEach(function (node) {
        var repo = node.getAttribute('data-github-latest');
        if (!repo) return;
        fetch('https://api.github.com/repos/' + repo + '/commits?per_page=1', { headers: { Accept: 'application/vnd.github.v3+json' } })
          .then(function (response) { return response.ok ? response.json() : Promise.reject(); })
          .then(function (data) {
            var date = Array.isArray(data) && data[0] && data[0].commit && data[0].commit.committer && data[0].commit.committer.date;
            node.textContent = formatDate(date);
          })
          .catch(function () { node.textContent = '—'; });
      });

      var errataTabs = document.querySelectorAll('[data-errata-tab]');
      var errataPanels = document.querySelectorAll('[data-errata-panel]');
      errataTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var key = tab.getAttribute('data-errata-tab');
          errataTabs.forEach(function (item) {
            var active = item === tab;
            item.classList.toggle('akari-books-tab--active', active);
            item.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          errataPanels.forEach(function (panel) {
            var active = panel.getAttribute('data-errata-panel') === key;
            panel.classList.toggle('akari-errata-panel--active', active);
            panel.hidden = !active;
          });
        });
      });
    })();
  </script>
</BaseLayout>
