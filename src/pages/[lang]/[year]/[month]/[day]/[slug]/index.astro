---
import { render } from 'astro:content';
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import Comments from '../../../../../../components/Comments.astro';
import { adjacentPosts, asDate, dateParts, getAllPosts, getPostsByLocale, languageOptions, postCategories, postUrl, resolveLocale } from '../../../../../../lib/content';
import { categoryName, categorySlugForLocale, categoryKeyFromName, label } from '../../../../../../lib/i18n';
import { artFallbackForSlug } from '../../../../../../lib/art';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => {
    const locale = resolveLocale(post.data);
    const { year, month, day } = dateParts(post.data.date);
    const slug = post.data.url_slug || post.data.slug || post.id.replace(/\.mdx?$/, '').split('/').pop();
    return { params: { lang: locale.lang_path, year, month, day, slug }, props: { post, locale } };
  });
}

const { post, locale } = Astro.props;
const { Content } = await render(post);
const localePosts = await getPostsByLocale(locale);
const { prev, next } = adjacentPosts(localePosts, post);
const allPosts = await getAllPosts();
const currentUrl = postUrl(post);
const options = languageOptions(currentUrl, locale, post.data.translation_key, allPosts);
const date = asDate(post.data.date);
const categories = postCategories(post);
const categoryKeys = postCategories(post).map(categoryKeyFromName).filter(Boolean) as string[];
const showStats = categoryKeys.some((key) => key === 'articles' || key === 'thoughts');
const leadCategoryRaw = categories[0] || label('common', 'archive', locale);
const leadCategory = categoryName(leadCategoryRaw, locale);
const slugId = post.data.url_slug || post.data.slug || post.id.replace(/\.mdx?$/, '').split('/').pop() || post.id;
const cover = post.data.cover || post.data.thumbnail || post.data.banner || post.data.image || await artFallbackForSlug(slugId);
---
<BaseLayout title={post.data.title} description={post.data.description} locale={locale} canonicalPath={currentUrl} type="article" image={cover} languageOptions={options}>
  <article class="article-shell">
    <header class="article-hero">
      <div class="article-appbar-rail">
        <a class="article-capsule article-capsule--lead" href={`/${locale.lang_path}/archives/`}><i class="ph ph-arrow-left"></i><span>{leadCategory}</span></a>
        <div class="article-capsule article-capsule--trailing">
          {date && <span>{date.toISOString().slice(0, 10)}</span>}
          <span>Akari / 篠崎香澄</span>
          {categories.map((category) => <a href={`/${locale.lang_path}/categories/${categorySlugForLocale(category, locale)}/`}>{categoryName(category, locale)}</a>)}
        </div>
      </div>
      <section class="article-hero-card glass-card">
        <div class="article-hero-kicker">{leadCategory}</div>
        <h1>{post.data.title}</h1>
        {post.data.description && <p>{post.data.description}</p>}
        {showStats && (
          <div class="post-stats" data-post-url={currentUrl}>
            <span class="post-stats__item"><i class="ph ph-eye"></i><span data-stats-views>0</span></span>
            <span class="post-stats__item"><i class="ph ph-chat-circle"></i><span data-stats-comments>0</span></span>
          </div>
        )}
      </section>
      <figure class="article-hero-cover"><img src={cover} alt={post.data.title} loading="lazy" decoding="async" /></figure>
      <div class="akari-read-progress" data-motion="read-progress"></div>
    </header>
    <div class="article-layout">
      <nav class="article-toc glass-card" aria-label={label('ui', 'tableOfContents', locale)}><strong>{label('ui', 'tableOfContents', locale)}</strong><div id="desktop-toc-body"></div></nav>
      <div class="article-prose glass-card"><Content /></div>
    </div>
    <nav class="post-navigation glass-card">
      {prev ? <a href={postUrl(prev)}><span>{label('post', 'prev', locale)}</span><strong>{prev.data.title}</strong></a> : <span>{label('post', 'none', locale)}</span>}
      {next ? <a href={postUrl(next)}><span>{label('post', 'next', locale)}</span><strong>{next.data.title}</strong></a> : <span>{label('post', 'none', locale)}</span>}
    </nav>
    {post.data.comment !== false && <Comments locale={locale} path={currentUrl} />}
  </article>
</BaseLayout>
