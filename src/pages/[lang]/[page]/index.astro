---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Comments from '../../../components/Comments.astro';
import Guestbook from '../../../components/Guestbook.astro';
import { aboutPath, languageOptions, LOCALES, pageUrl, resolveLocale } from '../../../lib/content';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (entry) => !entry.data.is_locale_selector);
  return pages
    .filter((page) => {
      const parts = page.id.split('/');
      return LOCALES.some((locale) => locale.lang_path === parts[0]) && parts[1] && parts[1] !== 'books';
    })
    .map((page) => ({ params: { lang: page.id.split('/')[0], page: page.id.split('/')[1] }, props: { page } }));
}

const { page } = Astro.props;
const locale = resolveLocale(page.data);
const { Content } = await render(page);
const allPages = await getCollection('pages');
const currentUrl = pageUrl(page);
const options = languageOptions(currentUrl, locale, page.data.translation_key, allPages);
const isGuestbook = page.data.layout === 'guestbook' || currentUrl.includes('/guestbook/');
const isAbout = page.data.layout === 'about';
// 留言板已与关于页评论区合并:统一使用关于页的 Twikoo 评论串(path 不变以保留全部评论)
const commentsPath = isGuestbook ? aboutPath(locale) : currentUrl;
---
<BaseLayout title={page.data.title || 'Akari'} description={page.data.description} locale={locale} canonicalPath={currentUrl} indexing={page.data.indexing !== false} languageOptions={options}>
  <section class="content-page glass-card">
    <h1>{page.data.title}</h1>
    <Content />
    {isGuestbook && <Guestbook locale={locale} />}
    {isGuestbook && <Comments locale={locale} path={commentsPath} />}
    {!isGuestbook && !isAbout && page.data.comment !== false && <Comments locale={locale} path={commentsPath} />}
  </section>
</BaseLayout>
