  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('[data-series-tab]');
      var panels = document.querySelectorAll('[data-series-panel]');
      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var key = tab.getAttribute('data-series-tab');
          tabs.forEach(function (item) {
            var active = item === tab;
            item.classList.toggle('akari-books-tab--active', active);
            item.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          panels.forEach(function (panel) {
            var active = panel.getAttribute('data-series-panel') === key;
            panel.classList.toggle('akari-books-series-panel--active', active);
            panel.hidden = !active;
          });
        });
      });

      var journeyCover = document.getElementById('akari-journey-cover-main');
      document.querySelectorAll('[data-volume-src]').forEach(function (button) {
        button.addEventListener('click', function () {
          if (!journeyCover) return;
          var src = button.getAttribute('data-volume-src');
          var label = button.getAttribute('data-volume-label') || '分册';
          if (src) journeyCover.setAttribute('src', src);
          journeyCover.setAttribute('alt', '高中数学之旅 ' + label + ' 封面');
          document.querySelectorAll('[data-volume-src]').forEach(function (item) {
            var active = item === button;
            item.classList.toggle('akari-books-volume--active', active);
            item.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        });
      });

      function formatDate(value) {
        if (!value) return '—';
        var date = new Date(value);
        if (Number.isNaN(date.getTime())) return '—';
        return date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
      }

      document.querySelectorAll('[data-github-latest]').forEach(function (node) {
        var repo = node.getAttribute('data-github-latest');
        if (!repo) return;
        fetch('https://api.github.com/repos/' + repo + '/commits?per_page=1', {
          headers: { Accept: 'application/vnd.github.v3+json' },
        })
          .then(function (response) { return response.ok ? response.json() : Promise.reject(); })
          .then(function (data) {
            var date = Array.isArray(data) && data[0] && data[0].commit && data[0].commit.committer && data[0].commit.committer.date;
            node.textContent = formatDate(date);
          })
          .catch(function () { node.textContent = '—'; });
      });

      var errataTabs = document.querySelectorAll('[data-errata-tab]');
      var errataPanels = document.querySelectorAll('[data-errata-panel]');
      errataTabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var key = tab.getAttribute('data-errata-tab');
          errataTabs.forEach(function (item) {
            var active = item === tab;
            item.classList.toggle('akari-books-tab--active', active);
            item.setAttribute('aria-selected', active ? 'true' : 'false');
          });
          errataPanels.forEach(function (panel) {
            var active = panel.getAttribute('data-errata-panel') === key;
            panel.classList.toggle('akari-errata-panel--active', active);
            panel.hidden = !active;
          });
        });
      });
    })();
  </script>
</BaseLayout>
