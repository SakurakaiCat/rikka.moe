---
import type { Locale } from '../lib/content';
import { categorySlugForKey, label } from '../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const local = (path: string) => `/${locale.lang_path}${path}`;
const bookHref = locale.lang === 'zh-CN' ? '/books/' : local('/books/');
const pathname = Astro.url.pathname;
const isBooksCurrent = pathname.startsWith('/books/') || pathname.startsWith(`/${locale.lang_path}/books/`);
const navItems = [
  { label: label('common', 'home', locale), href: `/${locale.lang_path}/`, icon: 'house' },
  { label: label('common', 'archive', locale), href: local('/archives/'), icon: 'article' },
  { label: label('common', 'categories', locale), href: local(`/categories/${categorySlugForKey('articles', locale)}/`), icon: 'folders' },
  { label: label('common', 'about', locale), href: local('/about/'), icon: 'user' },
  { label: label('common', 'books', locale), href: bookHref, icon: 'book-open-text', current: isBooksCurrent },
  { label: label('common', 'projects', locale), href: '/projects/', icon: 'briefcase', current: pathname.startsWith('/projects/') },
  { label: label('common', 'guestbook', locale), href: local('/guestbook/'), icon: 'chats-circle' },
  { label: 'GitHub', href: 'https://github.com/ShinozakiKasumi', icon: 'code', external: true },
];
---
<div class="akari-drawer-backdrop" data-akari-drawer-close hidden></div>
<aside id="akari-sidebar" class="akari-sidebar" aria-hidden="true" aria-label={label('ui', 'navigation', locale)}>
  <div class="akari-sidebar__card">
    <header class="akari-sidebar__header">
      <img src="/images/profile/avatar.jpg" alt="Akari" width="64" height="64" />
      <div>
        <strong>Akari</strong>
        <span>{locale.home_subtitle}</span>
      </div>
      <button class="icon-button akari-sidebar__close" type="button" aria-label={label('ui', 'closeMenu', locale)} data-akari-drawer-close>
        <i class="ph ph-x"></i>
      </button>
    </header>
    <nav class="akari-sidebar__nav">
      {navItems.map((item) => (
        <a class:list={[item.current && 'akari-sidebar__nav-active']} href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined} aria-current={item.current ? 'page' : undefined}>
          <i class={`ph ph-${item.icon}`}></i>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>
