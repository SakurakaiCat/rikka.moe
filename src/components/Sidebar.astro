---
import type { Locale } from '../lib/content';
import { label } from '../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const local = (path: string) => `/${locale.lang_path}${path}`;
const navItems = [
  { label: label('common', 'home', locale), href: `/${locale.lang_path}/`, icon: 'house' },
  { label: label('common', 'archive', locale), href: local('/archives/'), icon: 'article' },
  { label: label('common', 'categories', locale), href: local('/categories/长文/'), icon: 'folders' },
  { label: label('common', 'about', locale), href: local('/about/'), icon: 'user' },
  { label: label('common', 'books', locale), href: '/books/', icon: 'book-open-text' },
  { label: label('common', 'projects', locale), href: '/projects/', icon: 'briefcase' },
  { label: label('common', 'guestbook', locale), href: local('/guestbook/'), icon: 'chats-circle' },
  { label: 'GitHub', href: 'https://github.com/ShinozakiKasumi', icon: 'code', external: true },
];
---
<div class="akari-drawer-backdrop" data-akari-drawer-close hidden></div>
<aside id="akari-sidebar" class="akari-sidebar" aria-hidden="true" aria-label="Navigation">
  <div class="akari-sidebar__card">
    <header class="akari-sidebar__header">
      <img src="/images/profile/avatar.jpg" alt="Akari" width="64" height="64" />
      <div>
        <strong>Akari</strong>
        <span>写一点字，留一点光。</span>
      </div>
      <button class="icon-button akari-sidebar__close" type="button" aria-label="Close menu" data-akari-drawer-close>
        <i class="ph ph-x"></i>
      </button>
    </header>
    <nav class="akari-sidebar__nav">
      {navItems.map((item) => (
        <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
          <i class={`ph ph-${item.icon}`}></i>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
  </div>
</aside>
