---
import type { Locale } from '../lib/content';
import { label } from '../lib/i18n';

const { locale } = Astro.props as { locale: Locale };
const copy = {
  loading: label('guestbook', 'loading', locale),
  empty: label('guestbook', 'empty', locale),
  loadMore: label('guestbook', 'loadMore', locale),
  archiveTitle: label('guestbook', 'archiveTitle', locale),
  archiveNote: label('guestbook', 'archiveNote', locale),
};
---
<section class="guestbook-card" data-guestbook-root data-guestbook-copy={JSON.stringify(copy)}>
  <div class="guestbook-card__head">
    <h2>{copy.archiveTitle}</h2>
    <p>{copy.archiveNote}</p>
  </div>
  <div class="guestbook-card__status" data-guestbook-status>{copy.loading}</div>
  <div id="guestbook-list" class="guestbook-card__list" data-guestbook-list></div>
  <button class="guestbook-card__more" type="button" data-guestbook-more hidden>{copy.loadMore}</button>
</section>

<script is:inline>
(function() {
  function initGuestbook() {
    var root = document.querySelector('[data-guestbook-root]');
    if (!root) return;
    var copy;
    try { copy = JSON.parse(root.getAttribute('data-guestbook-copy') || '{}'); } catch (error) { copy = {}; }
    var list = root.querySelector('[data-guestbook-list]');
    var status = root.querySelector('[data-guestbook-status]');
    var more = root.querySelector('[data-guestbook-more]');
    var nextCursor = null;
    var loading = false;

    function escapeHtml(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function(char) {
        return ({ '&': '&', '<': '<', '>': '>', '"': '"', "'": '&#039;' })[char];
      });
    }

    function setStatus(message, kind) {
      if (!status) return;
      status.textContent = message || '';
      status.hidden = !message;
      status.setAttribute('data-kind', kind || '');
    }

    function formatDate(value) {
      var date = new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      try {
        return date.toLocaleString(document.documentElement.lang || 'en', { dateStyle: 'medium', timeStyle: 'short' });
      } catch (error) {
        return date.toISOString().slice(0, 16).replace('T', ' ');
      }
    }

    function buildEntry(entry) {
      var avatar = escapeHtml(entry.avatarUrl || entry.fallbackAvatarUrl || '');
      var fallback = escapeHtml(entry.fallbackAvatarUrl || '');
      var nickname = escapeHtml(entry.nickname || 'Guest');
      var content = escapeHtml(entry.content || '').replace(/\n/g, '<br>');
      var createdAt = escapeHtml(formatDate(entry.createdAt));
      return '<article class="guestbook-entry">' +
        '<img class="guestbook-entry__avatar" src="' + avatar + '" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src=\'' + fallback + '\'">' +
        '<div class="guestbook-entry__body"><header><strong>' + nickname + '</strong><time>' + createdAt + '</time></header><p>' + content + '</p></div>' +
        '</article>';
    }

    function renderEntries(entries, append) {
      if (!list) return;
      var html = (entries || []).map(buildEntry).join('');
      if (append) list.innerHTML += html;
      else list.innerHTML = html;
    }

    function loadEntries(append) {
      if (loading) return;
      loading = true;
      if (!append) setStatus(copy.loading || 'Loading…');
      var url = '/api/guestbook/list' + (append && nextCursor ? '?cursor=' + encodeURIComponent(nextCursor) : '');
      fetch(url, { credentials: 'omit' })
        .then(function(response) {
          if (!response.ok) throw new Error('HTTP ' + response.status);
          return response.json();
        })
        .then(function(data) {
          var entries = Array.isArray(data.entries) ? data.entries : [];
          renderEntries(entries, append);
          nextCursor = data.nextCursor || null;
          if (more) more.hidden = !nextCursor;
          if (!append && !entries.length) setStatus(copy.empty || 'No messages yet.');
          else setStatus('');
        })
        .catch(function() { setStatus(copy.errorServer || 'Failed to load.', 'error'); })
        .finally(function() { loading = false; });
    }

    if (more) more.addEventListener('click', function() { loadEntries(true); });

    loadEntries(false);
  }

  initGuestbook();
  document.addEventListener('astro:page-load', initGuestbook);
})();
</script>
