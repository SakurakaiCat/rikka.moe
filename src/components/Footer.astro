---
import type { Locale } from '../lib/content';
import { label } from '../lib/i18n';
const { locale } = Astro.props as { locale: Locale };
---
<footer class="akari-site-footer">
  <p class="akari-visit-counter">
    <span id="busuanzi_container_site_uv" style="display:none">{label('footer', 'siteVisitors', locale)}<span id="busuanzi_value_site_uv"></span></span>
    <span id="busuanzi_container_site_pv" style="display:none">{label('footer', 'siteViews', locale)}<span id="busuanzi_value_site_pv"></span></span>
  </p>
  <p class="akari-feed-link">
    <a href={`/${locale.lang_path}/atom.xml`} rel="alternate" type="application/atom+xml">Atom Feed</a>
  </p>
  <p class="akari-icp">
    <a href="https://icp.gov.moe/?keyword=20260097" target="_blank" rel="noopener">{label('footer', 'icp', locale)}</a>
  </p>
  <p class="akari-cf-cdn">
    <span>{label('footer', 'poweredByPrefix', locale)}</span><svg role="img" aria-label="Cloudflare" style="height:1em;width:auto;vertical-align:middle;display:inline" viewBox="0 -70 256 256" xmlns="http://www.w3.org/2000/svg"><g transform="translate(0,-1)"><path d="M202.4 50.4l-5.3-2.1C172.1 104.4 72.8 70.3 66.8 87c-1 11.3 54.2 2.1 93.7 4.1 12 .6 18.1 9.6 12.7 24.5h10.1c11.6-36.2 48.7-17.7 50.2-29.7-2.5-7.9-42.6 0-31.1-35.5z" fill="#FFF"/><path d="M176.3 109.3c1.6-5.3 1.1-10.6-1.6-13.8-2.7-3.2-6.4-5.3-11.2-5.9L71.2 88.6c-.5 0-1.1-.5-1.6-.5-.5-.5-.5-1.1 0-1.6.5-1.1 1.1-1.6 2.1-1.6l92.9-1.1c11.2-.5 22.8-9.6 27.1-20.2l5.3-13.8c0-.5.5-1.1 0-1.6C191.2 22.2 166.8 2 138.1 2c-26.6 0-49.4 17-57.4 40.9-5.3-3.7-11.7-5.9-19.1-5.3-12.7 1.1-22.8 11.7-24.3 24.4-.5 3.2 0 6.4.5 9.6C17 72.2 0 89.2 0 109.3c0 2.1 0 3.7.5 5.9.5 1.1 1.6 1.6 2.1 1.6h170.5c1.1 0 2.1-.5 2.1-1.6l1.6-5.9z" fill="#F4811F"/><path d="M205.5 49.9h-2.7c-.5 0-1.1.5-1.6 1.1l-3.7 12.7c-1.6 5.3-1.1 10.6 1.6 13.8 2.7 3.2 6.4 5.3 11.2 5.9l19.7 1.1c.5 0 1.1.5 1.6.5.5.5.5 1.1 0 1.6-.5 1.1-1.1 1.6-2.1 1.6l-20.2 1.1c-11.2.5-22.8 9.6-27.1 20.2l-1.1 4.8c-.5.5 0 1.6 1.1 1.6h70.1c1.1 0 1.6-.5 1.6-1.6 1.1-4.3 2.1-9.1 2.1-13.8 0-27.6-22.8-50.2-50.5-50.2z" fill="#FAAD3F"/></g></svg><span>{label('footer', 'poweredBySuffix', locale)}</span>
  </p>
  <p class="akari-footer-copy">© {new Date().getFullYear()} Akari / 篠崎香澄 · <a href={`/${locale.lang_path}/atom.xml`}>Atom</a></p>
  <script is:inline src="/assets/js/analytics.js" defer></script>
  <script is:inline src="/assets/js/post-stats.js" defer></script>
</footer>
