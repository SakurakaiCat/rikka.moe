---
import type { Locale, PostEntry } from '../lib/content';
import { asDate, postCategories, postUrl } from '../lib/content';
import { categoryName, categoryKeyFromName, categorySlugForKey, label, getHomepageModel } from '../lib/i18n';
import { collectTopicSummaries, postTopics, topicIcon, topicName, topicSlugForKey } from '../lib/topics';
import { resolveArtFallbacks } from '../lib/art';
import SponsorWall from './SponsorWall.astro';

const { locale, posts } = Astro.props as { locale: Locale; posts: PostEntry[] };
const model = getHomepageModel(locale);
const byCategory = (names: string[]) => posts.filter((post) => post.data.categories?.some((category) => names.includes(category)));
const articlePosts = byCategory(['长文', '長文', 'Essays', '記事']);
const thoughtPosts = byCategory(['随想', '隨想', 'Thoughts', 'つぶやき']);
const galleryPosts = byCategory(['相册', '相冊', 'Gallery', 'ギャラリー']);
const momentsPosts = posts.filter((post) => (post.data.categories || []).some((category) => categoryKeyFromName(category) === 'moments'));
const momentsHref = `/${locale.lang_path}/categories/${encodeURIComponent(categorySlugForKey('moments', locale))}/`;
const imagePattern = /!\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)|<img[^>]+src=["']([^"']+)["']/g;
const imagesOf = (post: PostEntry) => {
  const images = [post.data.cover, post.data.thumbnail, post.data.banner, post.data.image].filter(Boolean) as string[];
  for (const match of (post.body || '').matchAll(imagePattern)) {
    const src = match[1] || match[2];
    if (src && !images.includes(src)) images.push(src);
  }
  return images;
};
const slugOf = (post: PostEntry) => post.id.replace(/\.mdx?$/, '').split('/').pop() || post.id;
const artFallbackMap = await resolveArtFallbacks(
  [...articlePosts, ...thoughtPosts, ...galleryPosts].map((p) => slugOf(p)),
);
const firstImageOf = (post: PostEntry) => imagesOf(post)[0] || artFallbackMap.get(slugOf(post)) || '/images/profile/background.jpg';
const dateLabel = (post: PostEntry) => asDate(post.data.date)?.toISOString().slice(0, 10) || '';
const categoryLabel = (post: PostEntry) => categoryName(postCategories(post)[0] || '', locale);
const sectionLabels = {
  articles: label('category', 'articles', locale),
  thoughts: label('category', 'thoughts', locale),
  gallery: label('category', 'gallery', locale),
};
const archiveHref = `/${locale.lang_path}/archives/`;
const galleryHref = `/${locale.lang_path}/categories/${encodeURIComponent(categorySlugForKey('gallery', locale))}/`;
const topicsIndexHref = `/${locale.lang_path}/topics/`;

// 随想按年份分组(倒序)
const thoughtYearGroups = (() => {
  const map = new Map<string, PostEntry[]>();
  for (const post of thoughtPosts) {
    const year = asDate(post.data.date)?.getFullYear() ?? 0;
    const key = String(year);
    if (!map.has(key)) map.set(key, []);
    map.get(key)!.push(post);
  }
  return [...map.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));
})();

// 随想中出现的话题(用于筛选 chips)
const thoughtTopicChips = collectTopicSummaries(thoughtPosts).map(({ key }) => ({
  key,
  name: topicName(key, locale),
  count: thoughtPosts.filter((post) => postTopics(post).includes(key)).length,
}));
const topicMetaOf = (post: PostEntry) =>
  postTopics(post).map((key) => ({ key, name: topicName(key, locale), href: `${topicsIndexHref}${encodeURIComponent(topicSlugForKey(key, locale))}/` }));

const FEATURED_ARTICLE_COUNT = 5;
const GALLERY_COUNT = 2;
const allTopicChips = collectTopicSummaries(posts);
---
<div class="akari-bento-grid">
  <section class="akari-hero-banner">
    <div class="akari-hero-card glass-card">
      <picture class="akari-hero-media">
        <source media="(max-width: 699px)" srcset={model.hero.sources.mobile} />
        <source media="(max-width: 1199px)" srcset={model.hero.sources.tablet} />
        <img src={model.hero.sources.desktop} alt="" aria-hidden="true" loading="eager" />
      </picture>
      <div class="akari-hero-overlay"></div>
      <div class="akari-hero-content">
        <div class="akari-hero-content__inner">
        <div class="akari-hero-badge">{model.hero.badge}</div>
        <h1 class="akari-hero-title">
          <img class="akari-hero-avatar" src={model.hero.avatarSrc} alt={model.hero.avatarAlt} width="72" height="72" />
          <span>{model.hero.title}</span>
        </h1>
        <p class="akari-hero-brand-cn">{model.hero.brandCn}</p>
        <p class="akari-hero-subtitle">{model.hero.subtitle}</p>
        <div class="akari-hero-tags" aria-label="Tags">{model.hero.tags.map((tag: string) => <span>{tag}</span>)}</div>
        <nav class="akari-hero-actions" aria-label="Hero actions">
          {model.hero.ctas.map((cta: any) => <a class:list={["button", cta.primary && "button--primary"]} href={cta.href} target={cta.external ? '_blank' : undefined} rel={cta.external ? 'noopener noreferrer' : undefined}>{cta.label}</a>)}
        </nav>
        </div>
      </div>
    </div>
  </section>
</div>

<section id="akari-blog-feed" class="akari-blog-feed akari-home-sections akari-card-mosaic">
  <section class="akari-section akari-section--articles akari-mosaic-block">
    <header class="akari-section__head akari-section__head--split">
      <div><small>Essays</small><h2>{sectionLabels.articles}</h2></div>
      <a class="akari-section__more" href={archiveHref}>{label('common', 'viewAll', locale)} · {articlePosts.length}</a>
    </header>
    <div class="akari-article-glass-grid" data-motion="fade-up-children">
      {articlePosts.slice(0, FEATURED_ARTICLE_COUNT).map((post, index) => {
        const image = firstImageOf(post);
        return (
          <article class:list={["akari-article-glass-card", index === 0 && "akari-article-glass-card--featured", index === FEATURED_ARTICLE_COUNT - 1 && "akari-article-glass-card--wide"]}>
            <a href={postUrl(post)}>
              <div class="akari-article-glass-card__shine"></div>
              <figure class="akari-article-glass-card__cover"><img src={image} alt="" loading="lazy" decoding="async" /></figure>
              <div class="akari-article-glass-card__meta"><time>{dateLabel(post)}</time><span>{categoryLabel(post)}</span></div>
              <h3>{post.data.title}</h3>
              {post.data.description && <p>{post.data.description}</p>}
              <div class="post-stats" data-post-url={postUrl(post)}>
                <span class="post-stats__item" aria-label={label('post', 'views', locale)}><i class="ph ph-eye" aria-hidden="true"></i><span data-stats-views>0</span></span>
                <span class="post-stats__item" aria-label={label('post', 'comments', locale)}><i class="ph ph-chat-circle" aria-hidden="true"></i><span data-stats-comments>0</span></span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <div class="akari-mosaic-columns">
  <section class="akari-section akari-section--thoughts akari-mosaic-block">
    <header class="akari-section__head akari-section__head--split">
      <div><small>Timeline</small><h2>{sectionLabels.thoughts}</h2></div>
      <a class="akari-section__more" href={topicsIndexHref}>{label('common', 'allTopics', locale)}</a>
    </header>
    <div class="akari-thought-filter" role="group" aria-label={sectionLabels.thoughts}>
      <button type="button" class="akari-thought-chip is-active" data-topic-filter="*">{label('common', 'filterAll', locale)}<span>{thoughtPosts.length}</span></button>
      {thoughtTopicChips.map((chip) => (
        <button type="button" class="akari-thought-chip" data-topic-filter={chip.key}>{chip.name}<span>{chip.count}</span></button>
      ))}
    </div>
    <div class="akari-thought-years" data-motion="fade-up-children">
      {thoughtYearGroups.map(([year, yearPosts]) => (
        <section class="akari-thought-year-group">
          <h3 class="akari-thought-year-label">{year}</h3>
          <ul class="akari-thought-list">
            {yearPosts.map((post) => {
              const topics = topicMetaOf(post);
              return (
                <li class="akari-thought-item" data-topics={topics.map((topic) => topic.key).join(' ')}>
                  <a href={postUrl(post)}>
                    <time>{dateLabel(post)}</time>
                    <h3>{post.data.title}</h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </a>
                  <div class="akari-thought-item__side">
                    <div class="akari-thought-item__topics">
                      {topics.map((topic) => <a href={topic.href}>{topic.name}</a>)}
                    </div>
                    <div class="post-stats" data-post-url={postUrl(post)}>
                      <span class="post-stats__item" aria-label={label('post', 'views', locale)}><i class="ph ph-eye" aria-hidden="true"></i><span data-stats-views>0</span></span>
                      <span class="post-stats__item" aria-label={label('post', 'comments', locale)}><i class="ph ph-chat-circle" aria-hidden="true"></i><span data-stats-comments>0</span></span>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <div class="akari-mosaic-side" data-motion="fade-up-children">
  <section class="akari-section akari-section--gallery akari-mosaic-block">
    <header class="akari-section__head akari-section__head--split">
      <div><small>Gallery</small><h2>{sectionLabels.gallery}</h2></div>
      <a class="akari-section__more" href={galleryHref}>{label('common', 'viewAll', locale)} · {galleryPosts.length}</a>
    </header>
    <div class="akari-gallery-mosaic" data-motion="scale-up-children">
      {galleryPosts.slice(0, GALLERY_COUNT).map((post) => {
        const images = imagesOf(post).slice(0, 6);
        const slug = slugOf(post);
        const galleryFallback = artFallbackMap.get(slug) || '/images/profile/background.jpg';
        return (
          <article class="akari-gallery-card">
            <a href={postUrl(post)}>
              <div class:list={["akari-gallery-card__images", images.length <= 1 && "akari-gallery-card__images--single"]}>
                {(images.length ? images : [galleryFallback]).map((image) => <img src={image} alt="" loading="lazy" decoding="async" />)}
              </div>
              <div class="akari-gallery-card__body">
                <time>{dateLabel(post)}</time>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>

    <aside class="akari-topics-card glass-card">
      <div class="akari-topics-card__head">
        <i class="ph ph-hash" aria-hidden="true"></i>
        <div>
          <h2>{label('common', 'allTopics', locale)}</h2>
          <p>{allTopicChips.length} {locale.lang === 'en' ? 'topics' : locale.lang === 'ja' ? 'トピック' : '个话题'} · {posts.length} {label('common', 'postsCount', locale)}</p>
        </div>
      </div>
      <div class="akari-topics-card__grid">
        {allTopicChips.map(({ key, count }) => (
          <a class="akari-topics-card__tile" href={`${topicsIndexHref}${encodeURIComponent(topicSlugForKey(key, locale))}/`}>
            <i class={`ph ph-${topicIcon(key)}`} aria-hidden="true"></i>
            <span>{topicName(key, locale)}</span>
            <em>{count}</em>
          </a>
        ))}
      </div>
    </aside>
    {momentsPosts.length > 0 && (
      <aside class="moments-card glass-card">
        <div class="moments-card__head">
          <i class="ph ph-note-pencil" aria-hidden="true"></i>
          <div>
            <h2>{model.moments.title}</h2>
            <p>{model.moments.subtitle}</p>
          </div>
        </div>
        <ul class="moments-card__list">
          {momentsPosts.slice(0, 5).map((post) => (
            <li>
              <a href={postUrl(post)}>
                <time>{dateLabel(post)}</time>
                <h3>{post.data.title}</h3>
                {post.data.description && <p>{post.data.description}</p>}
              </a>
            </li>
          ))}
        </ul>
        <a class="moments-card__more" href={momentsHref}>{label('common', 'viewAll', locale)} · {momentsPosts.length}</a>
      </aside>
    )}
    <aside class="recent-comments-card glass-card" data-twikoo-env-id="https://comment.rikka.moe" data-twikoo-src="https://cdn.jsdelivr.net/npm/twikoo@1.7.13/dist/twikoo.all.min.js">
      <div class="recent-comments-card__head"><i class="ph ph-chat-circle-dots"></i><div><h2>{model.comments.title}</h2><p>{model.comments.subtitle}</p></div></div>
      <div class="recent-comments-card__list" data-empty={model.comments.empty} data-loading={model.comments.loading}>{model.comments.loading}</div>
    </aside>
  </div>
  </div>
</section>

<section class="akari-info-mosaic" aria-labelledby="akari-info-tabs-title">
  <header class="akari-info-tabs__header">
    <small>{model.tabs.eyebrow}</small>
    <h2 id="akari-info-tabs-title">{model.tabs.title}</h2>
  </header>
  <div class="akari-info-tabs__bar" role="tablist" aria-label={model.tabs.label}>
          <a href="#akari-nav-panel">{model.tabs.nav}</a>
          <a href="#akari-now-panel">{model.tabs.now}</a>
          <a href="#akari-projects-panel">{model.tabs.projects}</a>
          <a href="#akari-places-panel">{model.tabs.places}</a>
          <a href="#akari-albums-panel">{model.tabs.albums}</a>
          <a href="#akari-domains-panel">{model.tabs.domains}</a>
        </div>
        <div class="akari-info-panels akari-info-panels--mosaic" data-motion="fade-up-children">
          <article id="akari-nav-panel" class="akari-info-panel akari-info-panel--wide">
            <h3>{model.nav.title}</h3>
            <p>{model.nav.subtitle}</p>
            <div class="akari-info-nav__grid">
              {model.nav.stations.map((station: any) => <a class="station" href={station.href} target={station.href.startsWith('#') ? undefined : '_blank'} rel={station.href.startsWith('#') ? undefined : 'noopener noreferrer'}><span>[{station.number}]</span><strong>{station.name}</strong><code>{station.code}</code><small>{station.description}</small></a>)}
            </div>
          </article>
          <article id="akari-now-panel" class="akari-info-panel akari-span-2">
            <h3>{model.personal.now.title}</h3>
            <ul class="akari-info-now__list">{model.personal.now.items.map((item: any) => <li><span>{item.status}</span><p>{item.text}</p></li>)}</ul>
          </article>
          <article id="akari-projects-panel" class="akari-info-panel akari-span-4">
            <h3>{model.personal.projects.title}</h3>
            <div class="akari-info-project__grid">{model.personal.projects.items.map((project: any) => <section class="mini-card"><header><strong>{project.title}</strong><span>{project.status}</span></header><p>{project.description}</p><div>{project.tags.map((tag: string) => <em>{tag}</em>)}</div></section>)}</div>
          </article>
          <article id="akari-places-panel" class="akari-info-panel akari-span-2">
            <h3>{model.personal.places.title}</h3>
            <p>{model.personal.places.countLabel}</p>
            <div class="chips">{model.personal.places.cities.map((city: string) => <span>{city}</span>)}</div>
          </article>
          <article id="akari-albums-panel" class="akari-info-panel akari-span-4">
            <h3>{model.gallery.title}</h3>
            <div class="akari-info-gallery__grid">{model.gallery.sections.flatMap((section: any) => section.albums.slice(0, 4)).map((album: any) => <a class="akari-info-album" href={album.externalHref || '#'} target="_blank" rel="noopener noreferrer"><img src={album.coverSrc} alt={album.coverAlt} loading="lazy" /><span>{album.artist}</span><strong>{album.title}</strong></a>)}</div>
          </article>
          <article id="akari-domains-panel" class="akari-info-panel akari-span-3">
            <h3>{model.domains.title}</h3>
            <p>{model.domains.intro}</p>
            <details class="akari-info-domain__toggle" data-open={model.domains.openLabel} data-close={model.domains.closeLabel}>
              <summary>{model.domains.openLabel}</summary>
              {
                model.domains.groups.map((group: any) => (
                  <section class="akari-info-domain-group">
                    <h4>{group.title}</h4>
                    <div class="akari-info-domain__items">
                      {group.items.map((item: any) => (
                        <a class="akari-info-domain-item" href={item.href} target="_blank" rel="noopener noreferrer">
                          <div class="akari-info-domain-item__top">
                            <strong>{item.name}</strong>
                            <span>{item.status}</span>
                          </div>
                          <p>{item.note}</p>
                          {item.whois && <pre class="akari-info-domain-item__whois">{item.whois}</pre>}
                          <small class="akari-info-domain-item__action">{item.action}</small>
                        </a>
                      ))}
                    </div>
                  </section>
                ))
              }
            </details>
          </article>

    <section class="akari-feed-intro glass-card akari-info-mosaic__feed"><h2>{model.feed.title}</h2><p>{model.feed.text}</p></section>
  </div>
</section>

{model.personalIntro && <section class="akari-personal-intro glass-card" data-motion="fade-up">
  <article>
    <header class="akari-personal-intro__header">
      <small>{label('ui', 'personal', locale)}</small>
      <h2>{model.personalIntro.title}</h2>
      <p class="akari-personal-intro__memoir-note">{model.personalIntro.memoirNote}</p>
    </header>
    {model.personalIntro.cards?.length > 0 && (
      <div class="akari-profile-cards" data-motion="fade-up-children">
        {model.personalIntro.cards.map((card: any) => (
          <div class="akari-profile-card">
            <i class={`ph ph-${card.icon}`} aria-hidden="true"></i>
            <div>
              <small>{card.label}</small>
              <p>{card.value}</p>
            </div>
          </div>
        ))}
      </div>
    )}
    <div class="akari-personal-intro__figure-row">
      <figure class="akari-personal-intro__figure">
        <img src={model.personalIntro.image} alt={model.personalIntro.imageAlt} loading="lazy" />
        <figcaption>{model.personalIntro.closing}</figcaption>
      </figure>
      <details class="akari-personal-intro__memoir">
        <summary>
          <span class="akari-personal-intro__memoir-toggle" data-open={model.personalIntro.memoirToggleOpen} data-close={model.personalIntro.memoirToggleClose}>{model.personalIntro.memoirToggleOpen}</span>
          <i class="ph ph-caret-down" aria-hidden="true"></i>
        </summary>
        <div class="akari-personal-intro__body">
          {model.personalIntro.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
          {model.personalIntro.tags?.length > 0 && (
            <div class="akari-personal-intro__tags">
              <h3>{model.personalIntro.tagHeader}</h3>
              <ul>{model.personalIntro.tags.map((tag: string) => <li>{tag}</li>)}</ul>
            </div>
          )}
        </div>
      </details>
    </div>
  </article>
</section>}

<SponsorWall locale={locale} />

<script is:inline>
(function() {
  var TWIKOO_CDN = 'https://cdn.jsdelivr.net/npm/twikoo@1.7.13/dist/twikoo.all.min.js';

  function initRecentComments() {
    var card = document.querySelector('.recent-comments-card');
    if (!card || !card.dataset.twikooEnvId) return;
    var list = card.querySelector('.recent-comments-card__list');
    var src = card.dataset.twikooSrc || TWIKOO_CDN;

    function stripTags(value) {
      var div = document.createElement('div');
      div.innerHTML = value || '';
      return div.textContent || div.innerText || '';
    }

    function escapeHtml(value) {
      return stripTags(value).replace(/[&<>"]/g, function(char) {
        return ({ '&': '&', '<': '<', '>': '>', '"': '"' })[char];
      });
    }

    function normalizeDate(value) {
      if (!value) return '';
      var date = typeof value === 'number' && value < 10000000000 ? new Date(value * 1000) : new Date(value);
      if (Number.isNaN(date.getTime())) return '';
      return date.toLocaleDateString(document.documentElement.lang || 'zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
    }

    function render(items) {
      if (!Array.isArray(items) || !items.length) {
        list.textContent = list.dataset.empty;
        return;
      }
      list.innerHTML = items.slice(0, 5).map(function(item) {
        var nick = escapeHtml(item.nick || item.mailMd5 || 'Guest');
        var comment = escapeHtml(item.comment || item.text || '').slice(0, 140);
        var url = escapeHtml(item.url || item.href || '#');
        var time = normalizeDate(item.created || item.insertedAt || item.updated);
        var pageTitle = escapeHtml(item.pageTitle || item.title || '');
        return '<a class="recent-comment" href="' + url + '"><div class="recent-comment__top"><strong>' + nick + '</strong><time>' + time + '</time></div><span>' + comment + '</span>' + (pageTitle ? '<em>' + pageTitle + '</em>' : '') + '</a>';
      }).join('');
    }

    function loadComments() {
      if (!window.twikoo || !window.twikoo.getRecentComments) {
        list.textContent = list.dataset.empty;
        return;
      }
      window.twikoo.getRecentComments({ envId: card.dataset.twikooEnvId, pageSize: 5, includeReply: true })
        .then(render)
        .catch(function() { list.textContent = list.dataset.empty; });
    }

    var existing = document.querySelector('script[data-akari-twikoo="true"]');
    if (existing) {
      if (window.twikoo) loadComments();
      else existing.addEventListener('load', loadComments, { once: true });
      return;
    }
    var script = document.createElement('script');
    script.src = src;
    script.async = true;
    script.dataset.akariTwikoo = 'true';
    script.addEventListener('load', loadComments, { once: true });
    script.addEventListener('error', function() { list.textContent = list.dataset.empty; });
    document.head.appendChild(script);
  }

  initRecentComments();
  document.addEventListener('astro:page-load', initRecentComments);
})();
</script>
<script is:inline>
(function() {
  var toggle = document.querySelector('.akari-info-domain__toggle');
  if (!toggle) return;
  var openLabel = toggle.dataset.open || 'Open';
  var closeLabel = toggle.dataset.close || 'Close';
  var summary = toggle.querySelector('summary');
  if (!summary) return;
  toggle.addEventListener('toggle', function() {
    summary.textContent = toggle.open ? closeLabel : openLabel;
  });
})();
</script>
<script is:inline>
(function() {
  function initThoughtFilter(root) {
    var scope = root || document;
    var filterBar = scope.querySelector('.akari-thought-filter');
    if (!filterBar || filterBar.dataset.filterBound === 'true') return;
    filterBar.dataset.filterBound = 'true';
    var chips = filterBar.querySelectorAll('.akari-thought-chip');
    var items = scope.querySelectorAll('.akari-thought-item');
    var groups = scope.querySelectorAll('.akari-thought-year-group');
    if (!chips.length || !items.length) return;

    filterBar.addEventListener('click', function(event) {
      var chip = event.target.closest('.akari-thought-chip');
      if (!chip) return;
      chips.forEach(function(node) { node.classList.toggle('is-active', node === chip); });
      var topic = chip.dataset.topicFilter || '*';
      items.forEach(function(item) {
        var topics = (item.dataset.topics || '').split(/\s+/).filter(Boolean);
        item.hidden = topic !== '*' && !topics.includes(topic);
      });
      groups.forEach(function(group) {
        var visible = group.querySelectorAll('.akari-thought-item:not([hidden])').length;
        group.hidden = visible === 0;
      });
    });

    var memoir = scope.querySelector('.akari-personal-intro__memoir');
    if (memoir) {
      var label = memoir.querySelector('.akari-personal-intro__memoir-toggle');
      var openText = label.dataset.open;
      var closeText = label.dataset.close;
      memoir.addEventListener('toggle', function() {
        label.textContent = memoir.open ? closeText : openText;
      });
    }
  }

  initThoughtFilter(document);
  document.addEventListener('astro:page-load', function() { initThoughtFilter(document); });
})();
</script>
