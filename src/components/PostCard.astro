---
import type { PostEntry } from '../lib/content';
import { asDate, postCategories, postUrl, resolveLocale } from '../lib/content';
import { categoryName } from '../lib/i18n';
const { post } = Astro.props as { post: PostEntry };
const date = asDate(post.data.date);
const categories = postCategories(post);
const locale = resolveLocale(post.data);
const leadCategory = categories[0] ? categoryName(categories[0], locale) : '';
---
<article class="post-card">
  <a href={postUrl(post)}>
    {post.data.cover && <img src={post.data.cover} alt="" loading="lazy" decoding="async" />}
    <div class="post-card__body">
      <div class="post-card__meta">
        {date && <time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time>}
        {leadCategory && <span>{leadCategory}</span>}
      </div>
      <h3>{post.data.title}</h3>
      {post.data.description && <p>{post.data.description}</p>}
    </div>
  </a>
</article>
