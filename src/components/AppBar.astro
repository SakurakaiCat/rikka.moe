---
import type { Locale } from '../lib/content';
import { label } from '../lib/i18n';
interface Props {
  locale: Locale;
  title: string;
  section?: string;
  languageOptions: Array<Locale & { relativeUrl: string; isCurrent: boolean }>;
}
const { locale, title, section = '', languageOptions } = Astro.props;
---
<header class="akari-appbar top-app-bar">
  <div class="akari-appbar-rail">
    <div class="akari-capsule akari-capsule--leading">
      <button class="icon-button appbar-menu-button" type="button" aria-label={label('ui', 'menu', locale)} aria-controls="akari-sidebar" aria-expanded="false"><i class="ph ph-list"></i></button>
    </div>
    <div class="akari-capsule akari-capsule--center">
      <a class="akari-capsule--center-link" href={`/${locale.lang_path}/`}>
        {section && <span class="akari-appbar-section">{section}</span>}
        <span class="akari-appbar-title">{title}</span>
      </a>
    </div>
    <div class="akari-capsule akari-capsule--trailing">
      <button class="icon-button appbar-search-trigger" type="button" aria-label={label('ui', 'search', locale)}><i class="ph ph-magnifying-glass"></i></button>
      <button class="icon-button appbar-lang-trigger" type="button" aria-label={label('ui', 'switchLanguage', locale)} aria-controls="akari-lang-popover" aria-expanded="false"><i class="ph ph-translate"></i></button>
      <button class="icon-button appbar-settings-trigger" type="button" aria-label={label('ui', 'settings', locale)}><i class="ph ph-gear"></i></button>
    </div>
  </div>
</header>
<div id="akari-lang-popover" class="akari-popover" aria-hidden="true" style="display:none">
  <div class="akari-popover__content">
    {languageOptions.map((option) => (
      <a class:list={["akari-popover__item", option.isCurrent && "akari-popover__item--active"]} href={option.relativeUrl} data-locale-preference={option.lang_path}>{option.display_name}</a>
    ))}
  </div>
</div>
<div id="akari-search-modal" class="akari-search-modal" aria-hidden="true" style="display:none">
  <div class="akari-search-modal__backdrop"></div>
  <div class="akari-search-modal__content">
    <div class="akari-search-modal__header">
      <i class="ph ph-magnifying-glass"></i>
      <input type="text" class="akari-search-modal__input" placeholder={label('ui', 'searchPlaceholder', locale)} aria-label={label('ui', 'searchBlog', locale)} />
      <button class="akari-search-modal__close" type="button" aria-label={label('ui', 'closeSearch', locale)}><i class="ph ph-x"></i></button>
    </div>
    <div class="akari-search-modal__results"></div>
  </div>
</div>
<div id="akari-settings-popover" class="akari-popover akari-settings-popover" aria-hidden="true" style="display:none">
  <div class="akari-popover__content">
    <div class="akari-settings-section">
      <h3>{label('ui', 'colorScheme', locale)}</h3>
      <div class="akari-settings-palette">
        <button class="akari-settings-palette__item" data-color="#0a84ff" style="background:#0a84ff" aria-label="Blue"></button>
        <button class="akari-settings-palette__item" data-color="#5e5ce6" style="background:#5e5ce6" aria-label="Indigo"></button>
        <button class="akari-settings-palette__item" data-color="#98989d" style="background:#98989d" aria-label="Graphite"></button>
        <button class="akari-settings-palette__item" data-color="#ff375f" style="background:#ff375f" aria-label="Rose"></button>
        <button class="akari-settings-palette__item" data-color="#30d158" style="background:#30d158" aria-label="Mint"></button>
        <button class="akari-settings-palette__item" data-color="#64d2ff" style="background:#64d2ff" aria-label="Cyan"></button>
      </div>
    </div>
    <div class="akari-settings-section">
      <h3>{label('ui', 'theme', locale)}</h3>
      <div class="akari-settings-theme" role="group" aria-label={label('ui', 'theme', locale)}>
        <button class="akari-settings-theme__btn akari-settings-theme__btn--active" data-theme="auto" type="button">{label('ui', 'themeAuto', locale)}</button>
        <button class="akari-settings-theme__btn" data-theme="dark" type="button">{label('ui', 'themeDark', locale)}</button>
        <button class="akari-settings-theme__btn" data-theme="parchment" type="button">{label('ui', 'themeParchment', locale)}</button>
      </div>
    </div>
    <div class="akari-settings-section">
      <h3>{label('ui', 'fontSize', locale)}</h3>
      <div class="akari-settings-font-size">
        <button class="akari-settings-font-size__btn" data-size="small" type="button">{label('ui', 'fontSmall', locale)}</button>
        <button class="akari-settings-font-size__btn akari-settings-font-size__btn--active" data-size="medium" type="button">{label('ui', 'fontMedium', locale)}</button>
        <button class="akari-settings-font-size__btn" data-size="large" type="button">{label('ui', 'fontLarge', locale)}</button>
      </div>
    </div>
  </div>
</div>
