---
import '../styles/global.css';
import AppBar from '../components/AppBar.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../lib/content';
import { LOCALES, toAbsoluteUrl } from '../lib/content';
import { label } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  locale: Locale;
  canonicalPath: string;
  image?: string;
  indexing?: boolean;
  type?: 'website' | 'article';
  languageOptions?: Array<Locale & { relativeUrl: string; absoluteUrl: string; isCurrent: boolean }>;
  rootAutoRedirect?: boolean;
}

const {
  title,
  description = '',
  locale,
  canonicalPath,
  image = '/images/profile/avatar.jpg',
  indexing = true,
  type = 'website',
  languageOptions = LOCALES.map((loc) => ({ ...loc, relativeUrl: `/${loc.lang_path}/`, absoluteUrl: toAbsoluteUrl('https://rikka.moe', `/${loc.lang_path}/`), isCurrent: loc.lang === locale.lang })),
  rootAutoRedirect = false,
} = Astro.props;
const siteTitle = 'Akari';
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const canonical = toAbsoluteUrl('https://rikka.moe', canonicalPath);
const seoDescription = description || locale.home_description;
const siteCopy = {
  searchEmpty: label('ui', 'searchEmpty', locale),
  copy: label('ui', 'copy', locale),
  copied: label('ui', 'copied', locale),
};
const aiSummaryCopy = {
  title: label('ai', 'summaryTitle', locale),
  footerPrefix: label('ai', 'summaryFooterPrefix', locale),
  footerSuffix: label('ai', 'summaryFooterSuffix', locale),
};
const localeRoutingConfig = {
  preferenceKey: 'akari_locale_preference',
  defaultLocaleKey: 'en',
  defaultLocaleHomePath: '/en/',
  rootAutoRedirect,
  locales: LOCALES.map((loc) => ({
    key: loc.lang_path,
    homePath: `/${loc.lang_path}/`,
    browserLangPatterns: loc.browser_lang_patterns || [],
  })),
};
---
<!doctype html>
<html lang={locale.html_lang} class="mdui-theme-dark" data-font-locale={locale.lang_path}>
  <head>
    <meta charset="UTF-8" />
    <meta name="renderer" content="webkit" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="robots" content={indexing ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="author" content="Akari / 篠崎香澄" />
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonical} />
    {languageOptions.map((option) => <link rel="alternate" hreflang={option.lang} href={option.absoluteUrl} />)}
    <link rel="alternate" hreflang="x-default" href="https://rikka.moe/" />
    <link rel="icon" href="/images/profile/avatar.jpg" type="image/jpeg" />
    <link rel="apple-touch-icon" href="/images/profile/avatar.jpg" />
    <link rel="alternate" type="application/atom+xml" title={`${siteTitle} - ${locale.display_name}`} href={`/${locale.lang_path}/atom.xml`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image.startsWith('http') ? image : toAbsoluteUrl('https://rikka.moe', image)} />
    <meta property="og:locale" content={locale.og_locale} />
    <meta name="twitter:card" content="summary_large_image" />
    {locale.lang === 'en' && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {locale.lang === 'en' && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {locale.lang === 'en' && <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />}
    {locale.lang === 'en' && <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&display=swap" rel="stylesheet" />}
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/mdui@2/mdui.css" />
    <link rel="stylesheet" href="/fonts/pingfang/pingfang.css" />
    <link rel="stylesheet" href="/fonts/lxwk/lxwk.css" />
    <script src="https://unpkg.com/mdui@2/mdui.global.js"></script>
    <script defer src="https://analytics.rikka.moe/script.js" data-website-id="cdcfa939-9c79-48c3-8234-a2d87ebdf5b6"></script>
    <script is:inline set:html={`window.__AKARI_LOCALE_ROUTING__ = ${JSON.stringify(localeRoutingConfig)}; window.__AKARI_SITE_COPY__ = ${JSON.stringify(siteCopy)}; window.__AKARI_AI_SUMMARY_COPY__ = ${JSON.stringify(aiSummaryCopy)};`}></script>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': type === 'article' ? 'BlogPosting' : 'WebSite', name: title || siteTitle, headline: title || siteTitle, url: canonical, inLanguage: locale.html_lang, description: seoDescription, author: { '@type': 'Person', name: 'Akari / 篠崎香澄' } })}></script>
  </head>
  <body class="mdui-theme-dark">
    <div class="akari-snow" aria-hidden="true"></div>
    <AppBar locale={locale} title={title || siteTitle} languageOptions={languageOptions} />
    <Sidebar locale={locale} />
    <main class="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script type="module" src="/assets/js/akari-locale-routing.js"></script>
    <script type="module" src="/scripts/site.js"></script>
    <script is:inline>
    (function() {
      var container = document.querySelector('.akari-snow');
      if (!container) return;
      var snowflakes = ['❄', '❅', '❆', '·', '•'];
      var colors = ['#ffffff', '#e0f7fa', '#f4abba', '#c5e1ff'];
      var count = 50;
      for (var i = 0; i < count; i++) {
        var flake = document.createElement('span');
        flake.className = 'snowflake';
        flake.textContent = snowflakes[Math.floor(Math.random() * snowflakes.length)];
        flake.style.left = Math.random() * 100 + 'vw';
        flake.style.fontSize = (Math.random() * 0.8 + 0.6) + 'em';
        flake.style.color = colors[Math.floor(Math.random() * colors.length)];
        flake.style.animationDuration = (Math.random() * 5 + 5) + 's, ' + (Math.random() * 3 + 2) + 's';
        flake.style.animationDelay = (Math.random() * 10) + 's, ' + (Math.random() * 5) + 's';
        flake.style.opacity = Math.random() * 0.6 + 0.2;
        container.appendChild(flake);
      }
    })();
    </script>
    <script is:inline>
    (function() {
      var aiCopy = window.__AKARI_AI_SUMMARY_COPY__ || {};
      var els = document.querySelectorAll('.ai-summary');
      for (var i = 0; i < els.length; i++) {
        var el = els[i];
        if (el.querySelector('.ai-summary-title')) continue;
        var title = document.createElement('div');
        title.className = 'ai-summary-title';
        title.textContent = aiCopy.title || 'AI summary';
        el.insertBefore(title, el.firstChild);
        var footer = document.createElement('div');
        footer.className = 'ai-summary-footer';
        footer.innerHTML = (aiCopy.footerPrefix || 'Summary powered by') + '<img src=\"/images/deepseek-icon.svg\" alt=\"\" style=\"width:1em;height:1em;vertical-align:middle;margin:0 0.25em 0 0;display:inline-block;\">' + (aiCopy.footerSuffix || 'DeepSeek V4 Pro');
        el.appendChild(footer);
      }
    })();
    </script>
  </body>
</html>
